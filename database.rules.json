{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "pueblos": {
      ".indexOn": ["subregion"]
    },
    "vehiculos": {
      ".indexOn": ["meta/agencia", "meta/subregion", "meta/estado"],
      "$vehiculoId": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null"
        },
        "odometro": {
          ".read": "auth != null",
          "km_actual": {
            ".validate": "newData.isNumber() && (newData.val() >= data.val() || (root.child('roles').child(auth.uid).child('isAdmin').val() === true && newData.parent().child('motivo_ajuste').isString() && newData.parent().child('motivo_ajuste').val().length > 3))"
          },
          "version": {
            ".validate": "newData.isNumber()"
          },
          "updatedBy": {
            ".validate": "newData.isString()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "origen": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": "true"
          }
        },
        "historial": {
          ".read": "auth != null",
          "lecturasKm": {
            "$eventoId": {
              ".write": "auth != null"
            }
          },
          "mantenimientos": {
            "$mantId": {
              ".write": "auth != null"
            }
          },
          "eventosETM": {
            "$etmId": {
              ".write": "auth != null"
            }
          },
          "eventosAverias": {
            "$averiaId": {
              ".write": "auth != null"
            }
          }
        }
      }
    },
    "vehiculos_index": {
      ".indexOn": ["agencia", "subregion", "estado"]
    }
  }
}
