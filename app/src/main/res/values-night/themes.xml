<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Theme.TecniAppICE" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Marca -->
        <item name="colorPrimary">@color/ice_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ice_yellow_dark</item>
        <item name="colorOnSecondary">@color/on_dark</item>
        <item name="colorPrimaryContainer">@color/primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_dark</item>
        <item name="colorSecondaryContainer">@color/secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container_dark</item>
        <item name="colorTertiary">@color/success_500</item>
        <item name="colorOnTertiary">@color/on_dark</item>
        <item name="colorTertiaryContainer">@color/tertiary_container_dark</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container_dark</item>
        <item name="colorSurfaceTint">@color/ice_blue</item>

        <!-- Superficies/fondos (noche) -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorBackground">@color/bg_dark</item>
        <item name="colorOnBackground">@color/on_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurface">@color/on_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="colorOutlineVariant">@color/outline_variant_dark</item>

        <!-- Estados -->
        <item name="colorError">@color/error_500</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Estética -->
        <item name="materialCardViewStyle">@style/Tecni.Card.Dark</item>
        <item name="materialButtonStyle">@style/Tecni.Button.Dark</item>
        <item name="chipStyle">@style/Tecni.Chip.Dark</item>
        <item name="toolbarStyle">@style/Tecni.Toolbar.Dark</item>
    </style>

    <style name="Tecni.Card.Dark" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Tecni.Button.Dark" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="minHeight">44dp</item>
    </style>

    <style name="Tecni.Chip.Dark" parent="Widget.Material3.Chip.Filter">
        <item name="minHeight">36dp</item>
    </style>

    <style name="Tecni.Toolbar.Dark" parent="Widget.Material3.Toolbar">
        <item name="elevation">1dp</item>
    </style>
</resources>
