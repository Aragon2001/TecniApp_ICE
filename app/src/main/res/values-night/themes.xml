<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema oscuro suave de la aplicación -->
    <style name="Theme.TecniApp_ICE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Color primario (Azul ICE) -->
        <item name="colorPrimary">@color/ice_blue</item>
        <item name="colorPrimaryVariant">@color/ice_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Color secundario (Amarillo ICE) -->
        <item name="colorSecondary">@color/ice_yellow</item>
        <item name="colorSecondaryVariant">@color/ice_yellow_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Color de la barra de estado y navegación -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/ice_blue_dark</item>

        <!-- Colores de fondo y superficie más suaves -->
        <item name="android:colorBackground">@color/soft_dark_gray</item> <!-- Gris oscuro suave -->
        <item name="colorOnBackground">@color/light_gray</item> <!-- Texto en gris claro -->
        <item name="colorSurface">@color/dark_gray</item> <!-- Gris más oscuro para botones, tarjetas, etc. -->
        <item name="colorOnSurface">@color/white</item> <!-- Texto sobre superficies oscuras -->

        <!-- Fondo de la ventana y configuración de título -->
        <item name="android:windowBackground">@color/soft_dark_gray</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Color de acento para resaltados -->
        <item name="colorAccent">@color/ice_yellow</item> <!-- Amarillo ICE como color de acento -->
    </style>

    <!-- Overlay del AppBar con tonos oscuros -->
    <style name="Theme.TecniApp_ICE.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Overlay del Popup con fondo oscuro suave -->
    <style name="Theme.TecniApp_ICE.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Tema sin ActionBar -->
    <style name="Theme.TecniApp_ICE.NoActionBar" parent="Theme.TecniApp_ICE">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
