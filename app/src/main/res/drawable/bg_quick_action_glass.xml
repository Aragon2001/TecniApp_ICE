<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo translúcido glassmorphism para botones de acceso rápido -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capa base: degradado blanco semi-transparente de arriba hacia abajo -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D0FFFFFF"
                android:startColor="#EAFFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Borde sutil en azul ICE (15% opacidad) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#26005DAA" />
        </shape>
    </item>

</layer-list>
