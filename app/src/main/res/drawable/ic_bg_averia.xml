        android:pathData="M 164,35 L 180,30"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:alpha="0.7" />
    <path
        android:pathData="M 152,18 L 158,8"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:alpha="0.7" />

    <!-- ── Destello izquierdo ─────────────────────────────── -->
    <path
        android:pathData="M 38,75 L 24,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 40,88 L 24,90"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:alpha="0.7" />
