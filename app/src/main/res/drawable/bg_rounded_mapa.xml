<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo translúcido adaptado a tema -->
    <solid android:color="@color/glass_light" />


    <!-- Bordes redondeados -->
    <corners android:radius="16dp" />

    <!-- Borde sutil translúcido -->
    <stroke
        android:width="1dp"
        android:color="@color/outline_soft" />

    <!-- Sombra interna opcional -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
