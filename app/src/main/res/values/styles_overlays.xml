<resources>

    <!-- Toolbar (menús emergentes legibles) -->
    <style name="ThemeOverlay.Tecni.Toolbar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorOnSurface">@color/on_light</item>
        <item name="android:textColor">@color/on_light</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SearchBar/SearchView (look glass) -->
    <style name="ThemeOverlay.Tecni.Search" parent="ThemeOverlay.Material3">
        <item name="colorSurface">@color/glass_light</item>
        <item name="colorOnSurface">@color/on_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
    </style>

    <style name="ThemeOverlay.Tecni.Search.Dark" parent="ThemeOverlay.Material3">
        <item name="colorSurface">@color/glass_dark</item>
        <item name="colorOnSurface">@color/on_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
    </style>

    <!-- Base chips (SIN multilínea) -->
    <!-- Usa Filter (selección) o Assist (acción). Para filtros de estado, Filter es más apropiado -->
    <style name="Tecni.Chip.Base" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAlignment">center</item>
        <item name="android:gravity">center</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="chipMinTouchTargetSize">0dp</item>
    </style>

    <!-- Chips por estado -->
    <style name="Tecni.Chip.Pendiente" parent="Tecni.Chip.Base">
        <item name="chipBackgroundColor">@color/chip_pendiente</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Tecni.Chip.Asignada" parent="Tecni.Chip.Base">
        <item name="chipBackgroundColor">@color/chip_asignada</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Tecni.Chip.EnAtencion" parent="Tecni.Chip.Base">
        <item name="chipBackgroundColor">@color/chip_en_atencion</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Tecni.Chip.Resuelta" parent="Tecni.Chip.Base">
        <item name="chipBackgroundColor">@color/chip_resuelta</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Botones compactos para el nuevo diseño -->
    <style name="Tecni.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="backgroundTint">@color/ice_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="rippleColor">@color/ice_yellow</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">16dp</item>
    </style>

    <style name="Tecni.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">16dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Tecni.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">16dp</item>
    </style>

    <!-- Botones originales (para otros usos) -->
    <style name="Tecni.Button.Primary.Original" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="backgroundTint">@color/ice_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="rippleColor">@color/ice_yellow</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>

    <style name="Tecni.Button.Secondary.Original" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>

</resources>