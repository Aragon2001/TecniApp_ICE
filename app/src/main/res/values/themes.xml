<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TecniAppICE" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Marca -->
        <item name="colorPrimary">@color/ice_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ice_yellow</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Superficies (día) -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurface">@color/on_light</item>
        <item name="android:background">@color/bg_light</item>
        <item name="colorOnBackground">@color/on_light</item>
        <item name="colorOutline">@color/outline_soft</item>

        <!-- Estados -->
        <item name="colorError">@color/error_500</item>
        <item name="colorTertiary">@color/success_500</item>

        <!-- Window / barras -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Estética -->
        <item name="materialCardViewStyle">@style/Tecni.Card</item>
        <item name="materialButtonStyle">@style/Tecni.Button</item>
        <item name="chipStyle">@style/Tecni.Chip</item>
        <item name="toolbarStyle">@style/Tecni.Toolbar</item>
    </style>

    <style name="Tecni.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Tecni.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="minHeight">44dp</item>
    </style>

    <style name="Tecni.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="minHeight">36dp</item>
    </style>

    <style name="Tecni.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="elevation">2dp</item>
    </style>
</resources>
