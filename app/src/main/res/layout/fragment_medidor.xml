<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.medidor.MedidorFragment">

    <ScrollView
        android:id="@+id/scrollMedidor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:showDividers="none">





            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/transparent"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/medidor_consulta_title"
                        android:textColor="@color/ice_blue_dark" />

                    <TextView
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/medidor_consulta_descripcion"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutMedidor"
                        style="@style/Tecni.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/medidor_numero_hint"
                        app:startIconDrawable="@drawable/ic_round_search_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputMedidor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsultar"
                        style="@style/Tecni.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/medidor_consultar"
                        app:icon="@drawable/ic_round_search_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/medidor_result_title"
                        android:textColor="@color/ice_blue_dark" />

                    <TextView
                        android:id="@+id/valueSubregionHeader"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Subregión Guápiles" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="@color/transparent"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <androidx.gridlayout.widget.GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            app:columnCount="2"
                            app:rowCount="7">

                            <TextView
                                style="@style/TextAppearance.Material3.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_numero_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="0" />

                            <TextView
                                android:id="@+id/chipNumero"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="0"
                                app:layout_columnWeight="1"
                                tools:text="714" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_cliente_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="1" />

                            <TextView
                                android:id="@+id/chipCliente"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="1"
                                app:layout_columnWeight="1"
                                tools:text="GAS NACIONAL ZETA S.A." />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_localizacion_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="2" />

                            <TextView
                                android:id="@+id/chipLocalizacion"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="2"
                                app:layout_columnWeight="1"
                                tools:text="34095000114" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_calle_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="3" />

                            <TextView
                                android:id="@+id/chipCalle"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="3"
                                app:layout_columnWeight="1"
                                tools:text="950" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_poste_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="4" />

                            <TextView
                                android:id="@+id/chipPoste"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="4"
                                app:layout_columnWeight="1"
                                tools:text="001" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_metros_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="5" />

                            <TextView
                                android:id="@+id/chipMetros"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="5"
                                app:layout_columnWeight="1"
                                tools:text="14" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/medidor_pueblo_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="6" />

                            <TextView
                                android:id="@+id/chipPueblo"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="6"
                                app:layout_columnWeight="1"
                                tools:text="La Argentina" />
                        </androidx.gridlayout.widget.GridLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopiar"
                    style="@style/Tecni.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medidor_copiar"
                    app:icon="@drawable/ic_copy"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompartir"
                    style="@style/Tecni.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medidor_compartir"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />
            </LinearLayout>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoEncontrado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/textNoEncontradoTitle"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/medidor_no_encontrado_titulo"
                        android:textColor="@color/ice_blue_dark" />

                    <TextView
                        android:id="@+id/textNoEncontradoDescription"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="No encontramos el medidor 714. Puedes registrarlo manualmente." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMostrarRegistro"
                        style="@style/Tecni.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/medidor_no_encontrado_accion"
                        app:icon="@drawable/ic_round_search_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
