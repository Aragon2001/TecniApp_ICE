<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMedidor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textMedidoresTitle"
                style="@style/TextAppearance.Material3.HeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/medidor_screen_title"
                android:textColor="@color/ice_blue_dark" />

            <TextView
                android:id="@+id/textMedidoresSubtitle"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/medidor_header_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstadoMedidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iconEstadoMedidor"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/medidor_estado_icon_description"
                        android:src="@drawable/ic_cloud_download"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/ice_blue_dark" />

                    <TextView
                        android:id="@+id/textEstadoTitulo"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/medidor_estado_titulo_listo"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintStart_toEndOf="@id/iconEstadoMedidor"
                        app:layout_constraintTop_toTopOf="@id/iconEstadoMedidor"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/textEstadoDetalle"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/medidor_estado_listo"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintStart_toEndOf="@id/iconEstadoMedidor"
                        app:layout_constraintTop_toBottomOf="@id/textEstadoTitulo"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSyncState"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/medidor_chip_sync_ok"
                        app:chipIcon="@drawable/ic_check"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iconEstadoMedidor" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/medidor_consulta_title"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/medidor_consulta_descripcion"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutMedidor"
                        style="@style/Tecni.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/medidor_numero_hint"
                        app:startIconDrawable="@drawable/ic_round_search_24">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputMedidor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsultar"
                        style="@style/Tecni.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/medidor_consultar"
                        app:icon="@drawable/ic_round_search_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/medidor_result_title"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/valueSubregionHeader"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/chipNumero"
                            style="@style/TextAppearance.Material3.TitleLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/groupResultChips" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/groupResultChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            app:chipSpacingHorizontal="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEstadoMedidor"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/medidor_chip_status_ok"
                                app:chipIcon="@drawable/ic_check" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSyncResultado"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/medidor_chip_sync_ok"
                                app:chipIcon="@drawable/ic_cloud_download" />
                        </com.google.android.material.chip.ChipGroup>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <androidx.gridlayout.widget.GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            app:columnCount="2"
                            app:rowCount="6">

                            <TextView
                                style="@style/TextAppearance.Material3.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_cliente_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="0" />

                            <TextView
                                android:id="@+id/chipCliente"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="0"
                                app:layout_columnWeight="1" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_localizacion_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="1" />

                            <TextView
                                android:id="@+id/chipLocalizacion"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="1"
                                app:layout_columnWeight="1" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_calle_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="2" />

                            <TextView
                                android:id="@+id/chipCalle"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="2"
                                app:layout_columnWeight="1" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_poste_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="3" />

                            <TextView
                                android:id="@+id/chipPoste"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="3"
                                app:layout_columnWeight="1" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/medidor_metros_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="4" />

                            <TextView
                                android:id="@+id/chipMetros"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="4"
                                app:layout_columnWeight="1" />

                            <TextView
                                style="@style/TextAppearance.Material3.LabelLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/medidor_pueblo_label"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_column="0"
                                app:layout_row="5" />

                            <TextView
                                android:id="@+id/chipPueblo"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_column="1"
                                app:layout_row="5"
                                app:layout_columnWeight="1" />
                        </androidx.gridlayout.widget.GridLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLecturas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                style="@style/TextAppearance.Material3.TitleMedium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/medidor_lecturas_title"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/textLecturaActual"
                                style="@style/TextAppearance.Material3.BodyLarge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/medidor_lectura_actual_label"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/textLecturaAnterior"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/medidor_lectura_anterior_label"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp" />

                            <TextView
                                android:id="@+id/textLecturaFecha"
                                style="@style/TextAppearance.Material3.LabelLarge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/medidor_lectura_fecha_label"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarLectura"
                    style="@style/Tecni.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medidor_registrar_lectura"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopiar"
                        style="@style/Tecni.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/medidor_ver_detalles"
                        app:icon="@drawable/ic_eye"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCompartir"
                        style="@style/Tecni.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/medidor_sincronizar"
                        app:icon="@drawable/ic_cloud_download"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoEncontrado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/textNoEncontradoTitle"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/medidor_no_encontrado_titulo"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/textNoEncontradoDescription"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMostrarRegistro"
                        style="@style/Tecni.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/medidor_no_encontrado_accion"
                        app:icon="@drawable/ic_round_search_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
