<?xml version="1.0" encoding="utf-8"?>
<!--
    FIXES APLICADOS:
    1. Botones Editar/Eliminar: agregada constraintStart para anclarlos correctamente
       (antes solo tenían constraintEnd, podían superponerse con texto)
    2. Botones movidos a una fila con Barrier para alinear limpiamente
    3. Separador visual entre contenido y acciones
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/glass_light"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Ícono de luminaria -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconLuminaria"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:src="@drawable/ic_menu_luminarias"
                app:tint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Título: número de localización -->
        <TextView
            android:id="@+id/tvReparacionTitulo"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Localización"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@+id/cardEstadoLuminaria"
            app:layout_constraintStart_toEndOf="@id/cardIconLuminaria"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Chip de estado (Pendiente / Reparada) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstadoLuminaria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvReparacionEstado"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Estado"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Pueblo -->
        <TextView
            android:id="@+id/tvReparacionPueblo"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_report_location"
            android:text="Pueblo"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardIconLuminaria"
            app:layout_constraintTop_toBottomOf="@id/tvReparacionTitulo" />

        <!-- Detalle principal (materiales o info del cliente) -->
        <TextView
            android:id="@+id/tvReparacionDetalle"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="Detalle"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReparacionPueblo" />

        <!-- Info secundaria (ejecutor, vehículo, fecha) -->
        <TextView
            android:id="@+id/tvReparacionExtra"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="Extra"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReparacionDetalle" />

        <!--
            FIX: Botones de acción con ancla izquierda correcta.
            Antes: btnEditarReparacion solo tenía constraintEnd → podía
            quedar flotando sobre el texto en pantallas angostas.
            Ahora: ambos botones anclados a la derecha con constraintEnd
            en cadena y constraintStart explícito en btnEditarReparacion.
        -->
        <ImageButton
            android:id="@+id/btnEditarReparacion"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar reparación"
            android:src="@drawable/ic_edit"
            app:layout_constraintEnd_toStartOf="@+id/btnEliminarReparacion"
            app:layout_constraintStart_toStartOf="@id/guidelineAcciones"
            app:layout_constraintTop_toBottomOf="@id/tvReparacionExtra"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnEliminarReparacion"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar reparación"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvReparacionExtra"
            app:tint="?attr/colorError" />

        <!--
            Guideline al 60% del ancho para que los botones siempre
            queden en la mitad derecha sin pisar el texto.
        -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineAcciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.60" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>