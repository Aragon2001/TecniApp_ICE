<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Barra de estado lateral izquierda (coloreada por el adapter) -->
        <View
            android:id="@+id/viewStatusStrip"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="?attr/colorPrimary" />

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <!-- Fila de encabezado: ícono + localización + badge de estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Ícono del reporte (fondo y tinte coloreados por el adapter) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIconLuminaria"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:id="@+id/ivIconLuminaria"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_menu_luminarias"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Localización + Pueblo -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReparacionTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Localización"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="Loc. 010301110012" />

                    <TextView
                        android:id="@+id/tvReparacionPueblo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="4dp"
                        android:drawableStart="@drawable/ic_report_location"
                        android:text="Pueblo"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Pueblo: 0103 - San José" />
                </LinearLayout>

                <!-- Badge de estado (pill, coloreado por el adapter) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEstadoLuminaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <TextView
                        android:id="@+id/tvReparacionEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Estado"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        tools:text="Pendiente" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Divisor -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp" />

            <!-- Detalle principal (materiales o info del cliente) -->
            <TextView
                android:id="@+id/tvReparacionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Detalle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Camión: ABC123\nEstado: Pendiente" />

            <!-- Info secundaria (ejecutor, vehículo, fecha) -->
            <TextView
                android:id="@+id/tvReparacionExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Extra"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Reporte: 12/06/2026\nCliente: Juan Pérez" />

            <!-- Fila de acciones (alineada a la derecha) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <!-- Botón de acción principal (editar / atender) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBtnEditar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <ImageButton
                        android:id="@+id/btnEditarReparacion"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Editar reparación"
                        android:padding="9dp"
                        android:src="@drawable/ic_edit"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón eliminar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBtnEliminar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardBackgroundColor="?attr/colorErrorContainer"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <ImageButton
                        android:id="@+id/btnEliminarReparacion"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Eliminar reparación"
                        android:padding="9dp"
                        android:src="@drawable/ic_delete"
                        app:tint="?attr/colorOnErrorContainer" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
