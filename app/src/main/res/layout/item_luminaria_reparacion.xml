<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Franja de estado en la cima (color cambia según estado) -->
        <View
            android:id="@+id/viewStatusStrip"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/chip_pendiente" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <!-- Contenedor del ícono (color cambia según estado) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIconLuminaria"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#FFEBEE"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivIconLuminaria"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_menu_luminarias"
                    app:tint="@color/chip_pendiente" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Título: número de localización -->
            <TextView
                android:id="@+id/tvReparacionTitulo"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp"
                android:text="Localización"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/cardEstadoLuminaria"
                app:layout_constraintStart_toEndOf="@id/cardIconLuminaria"
                app:layout_constraintTop_toTopOf="@id/cardIconLuminaria" />

            <!-- Chip de estado (Pendiente / Reparada) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstadoLuminaria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/chip_pendiente"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvReparacionEstado"
                    style="@style/TextAppearance.Material3.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Estado"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Pueblo con ícono de ubicación -->
            <TextView
                android:id="@+id/tvReparacionPueblo"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="3dp"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/ic_report_location"
                android:text="Pueblo"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardIconLuminaria"
                app:layout_constraintTop_toBottomOf="@id/tvReparacionTitulo" />

            <!-- Divider sutil -->
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/dividerContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvReparacionPueblo" />

            <!-- Detalle principal (materiales o info del cliente) -->
            <TextView
                android:id="@+id/tvReparacionDetalle"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Detalle"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerContent" />

            <!-- Info secundaria (ejecutor, vehículo, fecha) -->
            <TextView
                android:id="@+id/tvReparacionExtra"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="Extra"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvReparacionDetalle" />

            <!-- Botones de acción con fondos circulares -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBtnEditar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toStartOf="@+id/cardBtnEliminar"
                app:layout_constraintStart_toStartOf="@id/guidelineAcciones"
                app:layout_constraintTop_toBottomOf="@id/tvReparacionExtra">

                <ImageButton
                    android:id="@+id/btnEditarReparacion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Editar reparación"
                    android:padding="8dp"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorOnPrimaryContainer" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBtnEliminar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="?attr/colorErrorContainer"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvReparacionExtra">

                <ImageButton
                    android:id="@+id/btnEliminarReparacion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Eliminar reparación"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    app:tint="?attr/colorOnErrorContainer" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Guideline al 55% para zona de botones -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineAcciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.55" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
