<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:clipToPadding="false"
    tools:context=".User.UserFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Indicador de carga -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressLoading"
            style="@style/Widget.Material3.LinearProgressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:trackThickness="4dp" />

        <LinearLayout
            android:id="@+id/contentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- TARJETA DE PERFIL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <!-- FOTO DE PERFIL -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imageProfile"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/nav_header_desc"
                            android:src="@drawable/default_profile_picture"

                            app:strokeWidth="2dp"
                            app:strokeColor="@color/ice_blue" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressPhoto"
                            style="@style/Widget.Material3.CircularProgressIndicator.Small"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:indicatorDirectionCircular="clockwise"
                            app:trackThickness="4dp" />
                    </FrameLayout>

                    <!-- BOTÓN CAMBIAR FOTO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePhoto"
            style="@style/Tecni.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cambiar foto"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                    <!-- DATOS DE USUARIO -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textDisplayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/ice_blue_dark"
                        tools:text="Carlos Rodríguez" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/dark_gray"
                        tools:text="carlos@ice.go.cr" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textUserId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/dark_gray"
                        tools:text="Cédula: 1-1234-5678" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/outline_soft" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textSummarySubregion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/dark_gray"
                        tools:text="Subregión: GAM" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textSummaryAgency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/dark_gray"
                        tools:text="Agencia: San José" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textSummaryVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/dark_gray"
                        tools:text="Vehículo: 123456 • Hilux" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA DE CONFIGURACIÓN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Subregión -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutSubregion"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:hint="@string/profile_subregion_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvSubregion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:dropDownHeight="wrap_content"
                            android:importantForAutofill="no"
                            android:focusable="false"
                            android:clickable="true"
                            android:padding="12dp"
                            tools:text="GAM" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Agencia -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutAgency"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_agency_label">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvAgency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:dropDownHeight="wrap_content"
                            android:importantForAutofill="no"
                            android:focusable="false"
                            android:clickable="true"
                            android:padding="12dp"
                            tools:text="San José" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Vehículo -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutVehicle"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_vehicle_label">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvVehicle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:dropDownHeight="wrap_content"
                            android:importantForAutofill="no"
                            android:focusable="false"
                            android:clickable="true"
                            android:padding="12dp"
                            tools:text="123456 • Hilux" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Teléfono -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPhone"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_phone_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhoneNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:maxLength="9"
                            android:padding="12dp"
                            tools:text="88888888" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_password_hint"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:padding="12dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirmar contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutConfirmPassword"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/profile_confirm_password_hint"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:padding="12dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Indicador de guardado -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressSaving"
                style="@style/Widget.Material3.LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:trackThickness="4dp" />

            <!-- BOTÓN GUARDAR CAMBIOS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChanges"
                style="@style/Tecni.Button.Primary.Original"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_save_changes" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
