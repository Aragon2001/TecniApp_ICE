<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="16dp"
    android:scrollbars="vertical"
    tools:context=".User.UserFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Indicador de carga -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressLoading"
            style="@style/Widget.Material3.LinearProgressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:trackThickness="4dp" />

        <LinearLayout
            android:id="@+id/contentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- TARJETA DE PERFIL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <!-- FOTO DE PERFIL -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imageProfile"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/nav_header_desc"
                            android:src="@drawable/default_profile_picture"
                            app:strokeWidth="2dp"
                            app:strokeColor="@color/ice_blue" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressPhoto"
                            style="@style/Widget.Material3.CircularProgressIndicator.Small"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:indicatorDirectionCircular="clockwise"
                            app:trackThickness="4dp" />
                    </FrameLayout>

                    <!-- BOTÓN CAMBIAR FOTO -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePhoto"
                        style="@style/Tecni.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Cambiar foto"
                        app:icon="@drawable/ic_camera"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                    <!-- DATOS DE USUARIO -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textDisplayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textColor="@color/ice_blue_dark"
                        tools:text="Carlos Rodríguez" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/dark_gray"
                        tools:text="carlos@ice.go.cr" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textUserId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/dark_gray"
                        tools:text="Cédula: 1-1234-5678" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA DE CONFIGURACIÓN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Región -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Región"
                        android:textColor="@color/ice_blue_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvRegion"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_bg_f0f2f4"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:inputType="none"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        tools:text="Atlántica" />

                    <!-- Subregión -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:text="Subregión"
                        android:textColor="@color/ice_blue_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvSubregion"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_bg_f0f2f4"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:inputType="none"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        tools:text="GAM" />

                    <!-- Agencia -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:text="Agencia"
                        android:textColor="@color/ice_blue_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvAgency"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_bg_f0f2f4"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:inputType="none"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        tools:text="San José" />

                    <!-- Vehículo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:text="Vehículo"
                        android:textColor="@color/ice_blue_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_bg_f0f2f4"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:inputType="none"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        tools:text="123456 • Hilux" />

                    <!-- Teléfono -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:text="Teléfono"
                        android:textColor="@color/ice_blue_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_bg_f0f2f4"
                        android:hint="88888888"
                        android:inputType="phone"
                        android:maxLength="9"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <!-- Contraseña -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:text="Contraseña"
                        android:textColor="@color/ice_blue_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_bg_f0f2f4"
                        android:hint="********"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <!-- Confirmar contraseña -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:text="Confirmar contraseña"
                        android:textColor="@color/ice_blue_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/rounded_bg_f0f2f4"
                        android:hint="********"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Indicador de guardado -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressSaving"
                style="@style/Widget.Material3.LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:trackThickness="4dp" />

            <!-- BOTÓN GUARDAR CAMBIOS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChanges"
                style="@style/Tecni.Button.Primary.Original"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_save_changes" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
