<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Tecni.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMaterialIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/inventario_icono_material"
                android:src="@drawable/ic_summary_material"
                app:tint="@color/ice_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMaterial"
                    style="@style/TextAppearance.Material3.BodyLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="@string/inventario_material_descripcion_placeholder" />

                <TextView
                    android:id="@+id/tvCodigo"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/inventario_material_codigo_placeholder" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCantidadBadge"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_header"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/inventario_material_existencia_badge_placeholder"
                android:textColor="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCantidad"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/inventario_material_existencia_placeholder" />

        <TextView
            android:id="@+id/tvVehiculo"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/inventario_material_vehiculo_placeholder" />

        <LinearLayout
            android:id="@+id/layoutAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSumar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"

                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                app:backgroundTint="@color/success_500"
                app:icon="@drawable/ic_add"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/white"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"

                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                app:backgroundTint="@color/ice_yellow"
                app:icon="@drawable/baseline_horizontal_rule_24"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/black"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/inventario_accion_eliminar"
                android:textSize="12sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/error_500"
                app:icon="@drawable/ic_delete"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/white"
                />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
