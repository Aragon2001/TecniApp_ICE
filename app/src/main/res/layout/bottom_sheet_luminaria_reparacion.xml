<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <!-- Handle -->
    <View
        android:id="@+id/viewHandle"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bottom_sheet_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════════════════════════════════════════
         CABECERA FIJA — no scrollea
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewHandle">

        <!-- Ícono del módulo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_menu_luminarias"
                app:tint="?attr/colorOnPrimaryContainer" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Título + subtítulo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloBottomSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrar reparación"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleBottomSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Completa los datos y guarda"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Chip de estado -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstadoReparacion"
            style="@style/Tecni.Chip.Status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Pendiente"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:chipBackgroundColor="?attr/colorSecondaryContainer" />

        <!-- Menú de reportes -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuReporteLuminarias"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/luminarias_menu_reportes"
            android:icon="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Separador -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.4"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSection" />

    <!-- ═══════════════════════════════════════════
         CONTENIDO SCROLLEABLE — dimensiones corregidas
         ═══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ═══════════════════════════════
                 SECCIÓN 1 — Detalles del caso
                 ═══════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Header de sección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="?attr/colorPrimaryContainer"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_location"
                                app:tint="?attr/colorOnPrimaryContainer" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Detalles del caso"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleDetalle"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="Expandir detalles"
                            android:icon="@drawable/ic_arrow_down" />
                    </LinearLayout>

                    <!-- Grupo de detalle del cliente (expandible) -->
                    <LinearLayout
                        android:id="@+id/groupDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Tarjeta de info del cliente -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="?attr/colorSurfaceVariant"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <!-- Localización -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Localización"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                    <TextView
                                        android:id="@+id/tvLocalizacionDetalle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="-"
                                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <com.google.android.material.divider.MaterialDivider
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp" />

                                <!-- Cliente -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:drawablePadding="4dp"
                                        android:drawableStart="@drawable/ic_person"
                                        android:text="Cliente"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                    <TextView
                                        android:id="@+id/tvClienteDetalle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Sin datos"
                                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>

                                <!-- Contacto -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:drawablePadding="4dp"
                                        android:drawableStart="@drawable/ic_phone"
                                        android:text="Contacto"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                    <TextView
                                        android:id="@+id/tvContactoDetalle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Sin datos"
                                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>

                                <!-- Observaciones -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:drawablePadding="4dp"
                                        android:drawableStart="@drawable/ic_edit"
                                        android:text="Observaciones"
                                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                    <TextView
                                        android:id="@+id/tvObservacionesDetalle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Sin datos"
                                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Botón llamar -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLlamarContacto"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:icon="@drawable/ic_phone"
                            android:text="Llamar al contacto"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="4dp" />

                    <!-- Campos técnicos editables -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLocalizacion"
                        style="@style/Tecni.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Número de localización"
                        app:helperText="Formato 000000000000"
                        app:startIconDrawable="@drawable/ic_location">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLocalizacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Cliente (solo supervisor/admin al registrar o editar pendiente) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCliente"
                        style="@style/Tecni.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Nombre del cliente"
                        android:visibility="gone"
                        app:startIconDrawable="@drawable/ic_person">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCliente"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contacto (solo supervisor/admin) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilContacto"
                        style="@style/Tecni.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Teléfono de contacto"
                        android:visibility="gone"
                        app:helperText="Puedes ingresar varios separados por coma"
                        app:startIconDrawable="@drawable/ic_phone">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContacto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilVehiculoLuminaria"
                        style="@style/Tecni.TextInput.Outlined.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/luminarias_camion_asignado"
                        android:visibility="gone"
                        tools:visibility="visible">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actVehiculoLuminaria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEstadoLuminaria"
                        style="@style/Tecni.TextInput.Outlined.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Estado de la reparación"
                        app:startIconDrawable="@drawable/ic_check">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actEstadoLuminaria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEjecutorLuminaria"
                        style="@style/Tecni.TextInput.Outlined.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Técnico ejecutor"
                        app:helperText="Puedes buscarlo en la lista de técnicos"
                        app:startIconDrawable="@drawable/ic_accounts">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actEjecutorLuminaria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════
                 SECCIÓN 2 — Materiales usados
                 ═══════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMateriales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Header de sección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="?attr/colorSecondaryContainer"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_summary_material"
                                app:tint="?attr/colorOnSecondaryContainer" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Materiales usados"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilMaterialLuminaria"
                        style="@style/Tecni.TextInput.Outlined.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Buscar material usado"
                        app:helperText="Selecciona un material para agregarlo"
                        app:startIconDrawable="@drawable/ic_summary_material">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actMaterialLuminaria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listMaterialesLuminaria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_luminaria_material" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════
                 SECCIÓN 3 — Observaciones
                 ═══════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEvidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Header de sección -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="?attr/colorTertiaryContainer"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_edit"
                                app:tint="?attr/colorOnTertiaryContainer" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="Observaciones"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilObservacionesLuminaria"
                        style="@style/Tecni.TextInput.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Notas o evidencia de la reparación"
                        app:helperText="Opcional">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etObservacionesLuminaria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════
         BARRA DE ACCIONES FIJA
         ═══════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomActionBar"
        style="@style/Tecni.BottomActionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarReparacion"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Iniciar"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResolverReparacion"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Resolver"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportarReparacion"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Exportar"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarReparacion"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:icon="@drawable/ic_save"
                android:text="Guardar reparación"
                app:iconGravity="textStart" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressGuardarReparacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
