<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCaso"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ice_blue_dark"
                android:textStyle="bold"
                tools:text="Caso IM-1265909-3-327186" />

            <TextView
                android:id="@+id/tvEstado"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_report_status_badge"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                tools:text="Resuelta" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFecha"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/ic_report_clock"
            android:drawablePadding="10dp"
            android:textColor="@color/dark_gray"
            tools:text="27 oct 2025 · 09:53" />

        <TextView
            android:id="@+id/tvAgencia"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_report_location"
            android:drawablePadding="10dp"
            android:textColor="@color/ice_blue_dark"
            tools:text="Agencia: Guácimo" />

        <TextView
            android:id="@+id/tvAtendido"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_report_person"
            android:drawablePadding="10dp"
            android:textColor="@color/dark_gray"
            tools:text="Atendido por: Juan Pérez" />

        <TextView
            android:id="@+id/tvVehiculo"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_report_vehicle"
            android:drawablePadding="10dp"
            android:textColor="@color/dark_gray"
            android:visibility="gone"
            tools:text="Vehículo: 9559"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvMateriales"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_report_material_badge"
            android:drawableStart="@drawable/ic_summary_material"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ice_blue_dark"
            tools:text="5 unidades · 2x Fusible dual 1.0" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
