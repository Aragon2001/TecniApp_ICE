<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Handle bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@color/outline_variant" />

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivDialogIcon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_icon_wrap_yellow"
                    android:contentDescription="@string/mi_vehiculo_dialog_titulo"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/status_assigned" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mi_vehiculo_dialog_titulo"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDialogSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/mi_vehiculo_dialog_subtitulo"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lectura actual -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilValorActual"
                style="@style/Tecni.TextInput.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/mi_vehiculo_dialog_valor_hint"
                app:boxStrokeColor="@color/outline_variant"
                app:hintTextColor="@color/on_surface_variant"
                app:startIconDrawable="@drawable/ic_speedometer"
                app:startIconTint="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etValorActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:nextFocusDown="@id/etObservaciones"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tipo de mantenimiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/mi_vehiculo_dialog_tipo"
                android:textAllCaps="true"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.07" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMantenimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAceite"
                    style="@style/Tecni.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_vehiculo_chip_aceite"
                    app:chipIcon="@drawable/ic_car"
                    app:chipIconTint="@color/status_assigned" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFrenos"
                    style="@style/Tecni.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_vehiculo_chip_frenos"
                    app:chipIcon="@drawable/ic_warning"
                    app:chipIconTint="@color/danger_red" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRevision"
                    style="@style/Tecni.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_vehiculo_chip_revision"
                    app:chipIcon="@drawable/ic_check"
                    app:chipIconTint="@color/success_green" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLlantas"
                    style="@style/Tecni.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_vehiculo_chip_llantas"
                    app:chipIcon="@drawable/ic_layers"
                    app:chipIconTint="@color/status_in_progress" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltros"
                    style="@style/Tecni.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_vehiculo_chip_filtros"
                    app:chipIcon="@drawable/ic_filter_list"
                    app:chipIconTint="@color/status_in_progress" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOtros"
                    style="@style/Tecni.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_vehiculo_chip_otros"
                    app:chipIcon="@drawable/ic_settings"
                    app:chipIconTint="@color/on_surface_variant" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Próximo mantenimiento box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_proximo_mant_box"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/mi_vehiculo_dialog_proximo"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/success_green" />

                <TextView
                    android:id="@+id/tvProximoMantenimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/success_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Próximo mantenimiento estimado: 80,320 km" />
            </LinearLayout>

            <!-- Observaciones -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilObservaciones"
                style="@style/Tecni.TextInput.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/mi_vehiculo_dialog_observaciones"
                app:boxStrokeColor="@color/outline_variant"
                app:hintTextColor="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelar"
                    style="@style/Tecni.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/mi_vehiculo_dialog_cancelar"
                    android:textColor="@color/on_surface_variant"
                    app:strokeColor="@color/outline_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    style="@style/Tecni.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mi_vehiculo_dialog_guardar_upper" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
