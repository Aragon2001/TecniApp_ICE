<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Tecni.DialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animation="@anim/dialog_scale_fade_in"
        android:background="@drawable/bg_dialog_glass"
        app:cardBackgroundColor="@color/surface_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivDialogIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_kpi_glow"
                    android:contentDescription="@string/mi_vehiculo_dialog_titulo"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/ice_yellow" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mi_vehiculo_dialog_titulo"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDialogSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/mi_vehiculo_dialog_subtitulo"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/on_surface_variant_light" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilValorActual"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/mi_vehiculo_dialog_valor_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etValorActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/mi_vehiculo_dialog_tipo"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMantenimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAceite"
                    style="@style/Tecni.Chip"
                    android:text="@string/mi_vehiculo_chip_aceite"
                    app:chipIcon="@drawable/ic_settings"
                    app:chipIconTint="@color/ice_yellow" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFrenos"
                    style="@style/Tecni.Chip"
                    android:text="@string/mi_vehiculo_chip_frenos"
                    app:chipIcon="@drawable/ic_warning"
                    app:chipIconTint="@color/error_500" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRevision"
                    style="@style/Tecni.Chip"
                    android:text="@string/mi_vehiculo_chip_revision"
                    app:chipIcon="@drawable/ic_check"
                    app:chipIconTint="@color/ice_blue" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLlantas"
                    style="@style/Tecni.Chip"
                    android:text="@string/mi_vehiculo_chip_llantas"
                    app:chipIcon="@drawable/ic_layers"
                    app:chipIconTint="@color/ice_blue_dark" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFiltros"
                    style="@style/Tecni.Chip"
                    android:text="@string/mi_vehiculo_chip_filtros"
                    app:chipIcon="@drawable/ic_filter_list"
                    app:chipIconTint="@color/tertiary_container_light" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOtros"
                    style="@style/Tecni.Chip"
                    android:text="@string/mi_vehiculo_chip_otros"
                    app:chipIcon="@drawable/ic_car"
                    app:chipIconTint="@color/ice_blue_dark" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilObservaciones"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/mi_vehiculo_dialog_observaciones">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Tecni.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/tertiary_container_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/mi_vehiculo_dialog_proximo"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/on_tertiary_container_light" />

                    <TextView
                        android:id="@+id/tvProximoMantenimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/on_tertiary_container_light"
                        tools:text="Próximo en ~ 4,800 km" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_vehiculo_dialog_cancelar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/mi_vehiculo_dialog_guardar_upper" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
