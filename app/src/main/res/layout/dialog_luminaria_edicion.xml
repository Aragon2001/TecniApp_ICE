<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLocalizacionReparacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número de localización">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLocalizacionReparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Estado"
        app:startIconDrawable="@drawable/ic_check">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actEstadoReparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEjecutorReparacion"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Técnico ejecutor"
        app:helperText="Puedes buscarlo en la lista de técnicos"
        app:startIconDrawable="@drawable/ic_accounts">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actEjecutorReparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMaterialReparacion"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Agregar material"
        app:helperText="Selecciona un material para agregarlo"
        app:startIconDrawable="@drawable/ic_summary_material">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actMaterialReparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvEmptyMaterialesReparacion"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="No hay materiales agregados." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listMaterialesReparacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false" />
</LinearLayout>
