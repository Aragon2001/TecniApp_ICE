<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="1dp"
    app:strokeColor="@color/outline_soft"
    app:cardBackgroundColor="@color/glass_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Título / Estado -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_light"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/chipEstado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstado"
            style="@style/Tecni.Chip.Pendiente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendiente"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitulo" />

        <!-- Miniatura de mapa -->

        <!-- Causa -->
        <ImageView
            android:id="@+id/imgMapa"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="68dp"
            android:background="@drawable/bg_rounded_mapa"
            android:contentDescription="Mapa de ubicación"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

        <TextView
            android:id="@+id/tvCausa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/on_light"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipEstado" />

        <!-- Observaciones -->
        <TextView
            android:id="@+id/tvObs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/tvCausa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <!-- Datos en TextViews -->
        <TextView
            android:id="@+id/tvCaso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Caso: 12345"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            app:layout_constraintTop_toBottomOf="@id/tvObs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvAsignado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Asignado a: Juan Pérez"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            app:layout_constraintTop_toBottomOf="@id/tvCaso"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvAtendido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Atendido por: —"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            app:layout_constraintTop_toBottomOf="@id/tvAsignado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvVehiculo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Vehículo: —"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            app:layout_constraintTop_toBottomOf="@id/tvAtendido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvNise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="NISE: 4830817001"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            app:layout_constraintTop_toBottomOf="@id/tvVehiculo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvRegion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Región: Guápiles"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            app:layout_constraintTop_toBottomOf="@id/tvNise"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvAgencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Agencia: Guácimo"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            app:layout_constraintTop_toBottomOf="@id/tvRegion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvMateriales"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/on_light"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvAgencia"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <!-- Coordenadas y Fecha -->
        <TextView
            android:id="@+id/tvCoords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Coords: X,Y"
            android:textSize="12sp"
            android:textColor="@color/dark_gray"
            app:layout_constraintTop_toBottomOf="@id/tvMateriales"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Fecha: 2025-09-25"
            android:textSize="12sp"
            android:textColor="@color/dark_gray"
            app:layout_constraintTop_toBottomOf="@id/tvCoords"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgMapa" />

        <!-- Botones -->
        <LinearLayout
            android:id="@+id/layoutAcciones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="start"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvFecha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAsignar"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asignar"
                android:textAllCaps="false"
                app:backgroundTint="@color/ice_yellow"
                android:textColor="@color/ice_blue_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAtender"
                style="@style/Widget.Material3.Button"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atender"
                android:textAllCaps="false"
                app:backgroundTint="@color/ice_blue"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResolver"
                style="@style/Widget.Material3.Button"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolver"
                android:textAllCaps="false"
                app:backgroundTint="@color/ice_blue"
                android:textColor="@color/white"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver"
                android:textAllCaps="false"
                app:strokeColor="@color/ice_blue"
                android:textColor="@color/ice_blue" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
