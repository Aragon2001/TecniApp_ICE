<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/glass_light"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="@color/outline_soft"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_light"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/chipEstado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstado"
            style="@style/Tecni.Chip.Pendiente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estado_pendiente"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitulo" />

        <ImageView
            android:id="@+id/imgMapa"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="68dp"
            android:background="@drawable/bg_rounded_mapa"
            android:contentDescription="@string/averia_ver_mapa"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo" />

        <TextView
            android:id="@+id/tvCausa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/on_light"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipEstado" />

        <TextView
            android:id="@+id/tvObs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCausa" />

        <TextView
            android:id="@+id/tvCaso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvObs"
            tools:text="Caso: 12345" />

        <TextView
            android:id="@+id/tvAsignado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCaso"
            tools:text="Asignado a: Juan Pérez" />

        <TextView
            android:id="@+id/tvAtendido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAsignado"
            tools:text="Atendido por: —" />

        <TextView
            android:id="@+id/tvVehiculo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAtendido"
            tools:text="Vehículo: ICE-001" />

        <TextView
            android:id="@+id/tvNise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVehiculo"
            tools:text="NISE: 4830817001" />

        <TextView
            android:id="@+id/tvRegion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNise"
            tools:text="Región: Guápiles" />

        <TextView
            android:id="@+id/tvAgencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRegion"
            tools:text="Agencia: Guácimo" />

        <TextView
            android:id="@+id/tvMateriales"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAgencia"
            tools:text="Materiales: Cable x3" />

        <TextView
            android:id="@+id/tvKilometraje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/on_light"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMateriales"
            tools:text="Kilometraje: 12000 → 12050" />

        <TextView
            android:id="@+id/tvCoords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvKilometraje"
            tools:text="Coords: 10.1234, -84.0987" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/imgMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCoords"
            tools:text="Evento: 01/01/2025" />

        <!-- Botones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVer"
            style="@style/Tecni.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/averia_cerrar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFecha" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsignar"
            style="@style/Tecni.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/averia_asignar"
            app:layout_constraintEnd_toStartOf="@id/btnAtender"
            app:layout_constraintHorizontal_chainStyle="spreadInside"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnVer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtender"
            style="@style/Tecni.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/averia_atender"
            app:layout_constraintBaseline_toBaselineOf="@id/btnAsignar"
            app:layout_constraintEnd_toStartOf="@id/btnResolver"
            app:layout_constraintHorizontal_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResolver"
            style="@style/Tecni.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/averia_resolver"
            app:layout_constraintBaseline_toBaselineOf="@id/btnAsignar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
