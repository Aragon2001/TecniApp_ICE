<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Tecni.Glass.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:padding="@dimen/glass_card_padding">

        <View
            android:id="@+id/viewEstadoIndicator"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:alpha="0.75"
            android:background="@color/ice_cyan"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="@dimen/glass_icon_main"
            android:layout_height="@dimen/glass_icon_main"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_glass"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toEndOf="@id/viewEstadoIndicator"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivTipoAveria"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/averias_title"
                android:padding="10dp"
                android:src="@drawable/ic_outage_new"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:tint="@color/ice_blue" />
        </FrameLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstado"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minHeight="24dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAllCaps="true"
            android:textSize="10sp"
            app:checkedIconVisible="false"
            app:chipMinHeight="24dp"
            app:chipMinTouchTargetSize="24dp"
            app:layout_constraintTop_toTopOf="@id/iconContainer"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="PENDIENTE" />

        <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/iconContainer"
            app:layout_constraintEnd_toStartOf="@id/chipEstado"
            app:layout_constraintTop_toTopOf="@id/iconContainer">

            <TextView
                android:id="@+id/tvTitulo"
                style="@style/Tecni.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Avería #IM-1253876" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRegion"
                    style="@style/Tecni.Text.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Región: Huetar Atlántica" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvAgencia"
                    style="@style/Tecni.Text.Subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Agencia: Guácimo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/ice_cyan" />

                <TextView
                    android:id="@+id/tvFecha"
                    style="@style/Tecni.Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Hace 2h • GPS" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detailStack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="@id/iconContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconContainer">

            <TextView
                android:id="@+id/tvCausa"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Causa: Falla en transformador" />

            <TextView
                android:id="@+id/tvObs"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Observaciones: Olor a quemado" />

            <TextView
                android:id="@+id/tvAsignado"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Asignado a: Jostin Aragon" />

            <TextView
                android:id="@+id/tvNise"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="NISE: 339589" />

            <TextView
                android:id="@+id/tvCliente"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Cliente: Residencial" />

            <TextView
                android:id="@+id/tvLocalizacion"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Localización: Poste 25" />

            <TextView
                android:id="@+id/tvDireccion"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                tools:text="Dirección: Calle 123" />

            <TextView
                android:id="@+id/tvAtendido"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Atendido por: Jostin Aragon" />

            <TextView
                android:id="@+id/tvKilometraje"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Kilometraje: 137352 → 337352" />

            <TextView
                android:id="@+id/tvVehiculo"
                style="@style/Tecni.Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Vehículo: 9559 (Grúa pequeña)" />
        </LinearLayout>

        <View
            android:id="@+id/divBeforeMap"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:alpha="0.25"
            android:background="?attr/colorOutline"
            app:layout_constraintTop_toBottomOf="@id/detailStack"
            app:layout_constraintStart_toStartOf="@id/iconContainer"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mapContainer"
            style="@style/Tecni.Glass.Card"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_marginTop="10dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintTop_toBottomOf="@id/divBeforeMap"
            app:layout_constraintStart_toStartOf="@id/iconContainer"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imgMapa"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/averia_ver_mapa"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_map_placeholder"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvMapaLabel"
                    style="@style/Tecni.Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_glass"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="Mapa"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="HardcodedText" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerMapa"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:icon="@drawable/ic_share_location24"
            android:iconPadding="8dp"
            android:minWidth="0dp"
            android:text="Ver mapa"
            app:layout_constraintEnd_toStartOf="@id/btnAsignar"
            app:layout_constraintHorizontalWeight="1"
            app:layout_constraintStart_toStartOf="@id/iconContainer"
            app:layout_constraintTop_toBottomOf="@id/mapContainer"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsignar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:icon="@drawable/ic_person"
            android:iconPadding="8dp"
            android:minWidth="0dp"
            android:text="Asignar"
            app:layout_constraintEnd_toStartOf="@id/btnAtender"
            app:layout_constraintHorizontalWeight="1"
            app:layout_constraintStart_toEndOf="@id/btnVerMapa"
            app:layout_constraintTop_toBottomOf="@id/mapContainer"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtender"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:icon="@drawable/ic_play_arrow"
            android:iconPadding="8dp"
            android:minWidth="0dp"
            android:text="Atender"
            app:layout_constraintEnd_toStartOf="@id/btnResolver"
            app:layout_constraintHorizontalWeight="1"
            app:layout_constraintStart_toEndOf="@id/btnAsignar"
            app:layout_constraintTop_toBottomOf="@id/mapContainer"
            tools:ignore="HardcodedText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResolver"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:icon="@drawable/ic_check"
            android:iconPadding="8dp"
            android:minWidth="0dp"
            android:text="Resolver"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontalWeight="1"
            app:layout_constraintStart_toEndOf="@id/btnAtender"
            app:layout_constraintTop_toBottomOf="@id/mapContainer"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
