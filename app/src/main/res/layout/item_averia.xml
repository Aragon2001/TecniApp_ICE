<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- LINEA VERTICAL MODERNA (estado) -->
        <View
            android:id="@+id/viewEstadoIndicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:alpha="0.85"
            android:background="@color/ice_cyan"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Contenido real separado de la línea -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentShell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/viewEstadoIndicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ice_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    tools:text="Avería #IM-1253876-3-320502" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEstado"
                    style="@style/Tecni.Chip.Base"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:checkedIconVisible="false"
                    app:chipMinTouchTargetSize="0dp"
                    tools:text="Pendiente" />
            </LinearLayout>

            <!-- Divisor -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@color/outline_soft"
                app:layout_constraintTop_toBottomOf="@id/headerLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Contenido (AHORA A ANCHO COMPLETO) -->
            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider">

                <TextView
                    android:id="@+id/tvCausa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_light"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp"
                    tools:text="Falla en transformador de distribución" />

                <TextView
                    android:id="@+id/tvObs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="6"
                    android:textColor="@color/dark_gray"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    tools:text="Se reporta olor a quemado y chispas intermitentes en el poste principal" />

                <LinearLayout
                    android:id="@+id/infoList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAsignado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="Asignado a: Jostin Aragon" />

                    <TextView
                        android:id="@+id/tvNise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="NISE: 339589" />

                    <TextView
                        android:id="@+id/tvCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="Cliente: Residencial" />

                    <TextView
                        android:id="@+id/tvLocalizacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="Localización: Poste 25" />

                    <TextView
                        android:id="@+id/tvDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Dirección: Calle 123, Ciudad" />

                    <TextView
                        android:id="@+id/tvAtendido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="Atendido por: Jostin Aragon" />

                    <TextView
                        android:id="@+id/tvKilometraje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="Kilometraje: 137352 → 337352" />

                    <TextView
                        android:id="@+id/tvRegion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="Región: Huetar Atlántica" />

                    <TextView
                        android:id="@+id/tvAgencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_light"
                        android:textSize="12sp"
                        tools:text="Agencia: Guácimo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVehiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/on_light"
                    android:textSize="12sp"
                    tools:text="Vehículo: 9559 (Grúa pequeña)" />

                <!-- Fecha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/dark_gray" />

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/dark_gray"
                        android:textSize="11sp"
                        tools:text="Evento: 4/10/2025 1:39 p.m." />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD MAPA (arriba de botones) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapa"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_soft"
                app:layout_constraintTop_toBottomOf="@id/contentLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgMapa"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/averia_ver_mapa"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_map_placeholder" />


                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTONES CON SCROLL HORIZONTAL -->
            <HorizontalScrollView
                android:id="@+id/buttonsScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fillViewport="true"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/cardMapa"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:id="@+id/buttonsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:paddingVertical="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerMapa"
                        style="@style/Tecni.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/averia_ver_mapa"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_share_location24"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAsignar"
                        style="@style/Tecni.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/averia_asignar"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_person"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAtender"
                        style="@style/Tecni.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/averia_atender"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_play_arrow"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResolver"
                        style="@style/Tecni.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/averia_resolver"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />
                </LinearLayout>
            </HorizontalScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
