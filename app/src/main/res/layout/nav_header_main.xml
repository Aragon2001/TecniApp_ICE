<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nav_header_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:paddingStart="24dp"
    android:paddingTop="32dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Avatar con ring de acento ICE cyan -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageViewProfile"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="@string/nav_header_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/default_profile_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Tecni.Corner.Full"
        app:strokeColor="@color/ice_cyan"
        app:strokeWidth="2.5dp" />

    <!-- Indicador de estado online -->
    <View
        android:id="@+id/viewStatusDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/nav_status_dot"
        app:layout_constraintBottom_toBottomOf="@id/imageViewProfile"
        app:layout_constraintEnd_toEndOf="@id/imageViewProfile" />

    <!-- Nombre completo -->
    <TextView
        android:id="@+id/textViewFullName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:letterSpacing="0.01"
        android:maxLines="2"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageViewProfile"
        app:layout_constraintTop_toTopOf="@id/imageViewProfile"
        tools:text="Carlos Rodríguez Solís" />

    <!-- Badge de rol: TÉCNICO / SUPERVISOR / ADMINISTRADOR -->
    <TextView
        android:id="@+id/textViewRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/nav_role_badge_bg"
        android:letterSpacing="0.07"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textColor="#B3E8FF"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/textViewFullName"
        app:layout_constraintTop_toBottomOf="@id/textViewFullName"
        tools:text="TÉCNICO" />

    <!-- Email -->
    <TextView
        android:id="@+id/textViewEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#99C8E8"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/textViewFullName"
        app:layout_constraintTop_toBottomOf="@id/textViewRole"
        tools:text="carlos.rodriguez@ice.go.cr" />

    <!-- Barrier: separa zona de avatar+info de la sección de datos -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierProfileBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="imageViewProfile,textViewEmail" />

    <!-- Línea divisora sutil -->
    <View
        android:id="@+id/dividerNavHeader"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#22FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierProfileBottom" />

    <!-- Sección de datos compacta -->
    <LinearLayout
        android:id="@+id/layoutInfoSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerNavHeader">

        <TextView
            android:id="@+id/textViewCedula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7DAECF"
            android:textSize="12sp"
            tools:text="Cédula: 1-1234-5678" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewSubregion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7DAECF"
                android:textSize="12sp"
                tools:text="Subregión: GAM" />

            <TextView
                android:id="@+id/textViewAgency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7DAECF"
                android:textSize="12sp"
                tools:text="Agencia: San José" />

        </LinearLayout>

        <TextView
            android:id="@+id/textViewVehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#7DAECF"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Vehiculo: 103-0000" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
