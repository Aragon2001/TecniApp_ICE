<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.averias.AveriasFragment">

    <!-- AppBar con filtros rápidos colapsables -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <LinearLayout
                android:id="@+id/filtersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                app:layout_collapseMode="parallax">

                <!-- Fila 1: Búsqueda + Botón filtros avanzados -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBuscar"
                        style="@style/Tecni.Search.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/averias_buscar"
                        app:endIconMode="clear_text"
                        app:startIconDrawable="@drawable/ic_search_inline"
                        app:startIconTint="?attr/colorOnSurfaceVariant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:paddingVertical="10dp"
                            android:singleLine="true"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón de filtros avanzados con badge -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFiltrosAvanzados"
                        style="@style/Tecni.Button.Outlined.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="44dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/averias_filtrar"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_filter_list"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="18dp" />

                </LinearLayout>

                <!-- Fila 2: Toggles de estado pill -->
                <HorizontalScrollView
                    android:id="@+id/chipsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:fadingEdge="horizontal"
                    android:requiresFadingEdge="horizontal"
                    android:fadingEdgeLength="24dp">

                    <LinearLayout
                        android:id="@+id/toggleEstadoGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp"
                        android:paddingEnd="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleTodos"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/averia_estado_todos"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTogglePendiente"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/estado_pendiente"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleAsignada"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/estado_asignada"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleEnAtencion"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/estado_en_atencion"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleResuelta"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/estado_resuelta"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleAnulada"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/estado_anulada"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:strokeWidth="1.5dp" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Fila 3: Chips de agencia rápida (subregión del usuario) -->
                <LinearLayout
                    android:id="@+id/rowAgenciasRapidas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- tvAgenciasLabel retenido sin visibilidad para no romper binding -->
                    <TextView
                        android:id="@+id/tvAgenciasLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="@string/averias_agencias_label"
                        android:textSize="11sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupAgenciasRapidas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="false" />

                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Fila 4: Resumen compacto de filtros activos (fecha, agencia, región) -->
                <!-- Se muestra solo cuando hay filtros activos; el texto lo actualiza el Fragment -->
                <TextView
                    android:id="@+id/tvFiltroResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="2dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="📅 01/06 09:00 → 30/06 18:00 · Agencia: Guácimo"
                    tools:visibility="visible" />

                <!-- Dropdowns ocultos (para compatibilidad con Fragment: región y agencia) -->
                <!-- Se gestionan desde el bottom sheet de filtros, pero se mantienen en el árbol
                     para que el Fragment pueda acceder a sus valores sin romper la lógica. -->
                <LinearLayout
                    android:id="@+id/spinnersRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegion"
                        style="@style/Tecni.Dropdown.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/averias_filtrar_region"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvRegion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:singleLine="true"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAgencia"
                        style="@style/Tecni.Dropdown.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="@string/averias_filtrar_agencia"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvAgencia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:singleLine="true"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido principal: lista de averías -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAverias"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="80dp"
                android:scrollbars="none"
                tools:listitem="@layout/item_averia" />

            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/averias_vacio"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FABs: columna en esquina inferior derecha -->
    <LinearLayout
        android:id="@+id/fabColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- FAB: volver a mostrar filtros cuando están colapsados -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_filter_list"
            android:tint="@color/white"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:fabSize="mini"
            tools:visibility="visible" />

        <!-- FAB: abrir mapa completo de averías -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/averias_mapa_fab_desc"
            android:src="@drawable/map_24px"
            android:tint="@color/white"
            app:backgroundTint="@color/ice_blue"
            app:fabSize="mini" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
