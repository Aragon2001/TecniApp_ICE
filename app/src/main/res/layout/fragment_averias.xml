<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.averias.AveriasFragment">

    <!-- AppBar completamente colapsable -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <!-- Contenedor completo que se ocultará -->
            <LinearLayout
                android:id="@+id/filtersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                app:layout_collapseMode="parallax">

                <!-- Barra de búsqueda (PILL / ovalada y compacta) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBuscar"
                    style="@style/Tecni.Search.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/averias_buscar"
                    app:endIconMode="clear_text"
                    app:startIconDrawable="@drawable/ic_search_inline"
                    app:startIconTint="?attr/colorOnSurfaceVariant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBuscar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:paddingVertical="10dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Fila compacta fecha -->
                <LinearLayout
                    android:id="@+id/dateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDateFilter"
                        style="@style/Tecni.Button.Outlined.Compact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxWidth="280dp"
                        android:minHeight="40dp"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/averias_filtro_fecha_todas"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_calendar"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearDate"
                        style="@style/Tecni.Button.Text.Compact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:minHeight="40dp"
                        android:text="@string/averias_filtro_fecha_limpiar"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Chips (compactos) -->
                <HorizontalScrollView
                    android:id="@+id/chipsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="4dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTodos"
                            style="@style/Tecni.Chip.Resuelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/averia_estado_todos"
                            app:checkedIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPendiente"
                            style="@style/Tecni.Chip.Pendiente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/estado_pendiente"
                            app:checkedIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAsignada"
                            style="@style/Tecni.Chip.Asignada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/estado_asignada"
                            app:checkedIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEnAtencion"
                            style="@style/Tecni.Chip.EnAtencion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/estado_en_atencion"
                            app:checkedIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipResuelta"
                            style="@style/Tecni.Chip.Resuelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/estado_resuelta"
                            app:checkedIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAnulada"
                            style="@style/Tecni.Chip.Anulada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/estado_anulada"
                            app:checkedIconVisible="true" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Spinners modernos (ovalados, compactos, NO crecen por texto) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/spinnersRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRegion"
                        style="@style/Tecni.Dropdown.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/averias_filtrar_region"
                        app:endIconMode="dropdown_menu"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tilAgencia"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_weight="1">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvRegion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="13sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAgencia"
                        style="@style/Tecni.Dropdown.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:hint="@string/averias_filtrar_agencia"
                        app:endIconMode="dropdown_menu"
                        app:layout_constraintStart_toEndOf="@id/tilRegion"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tilRegion"
                        app:layout_constraintHorizontal_weight="1">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvAgencia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="13sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido principal -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAverias"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_averia" />

            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/averias_vacio"
                android:textColor="?attr/colorOnBackground"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Action Button para mostrar filtros -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_filter_list"
        android:tint="@color/background"
        app:backgroundTint="@color/ice_blue" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
