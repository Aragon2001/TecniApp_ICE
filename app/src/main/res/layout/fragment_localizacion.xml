<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/localizacionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.localizacion.LocalizacionFragment">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cameraZoom="10"
            app:uiRotateGestures="true" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/overlayTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:layout_gravity="top"
            app:cardBackgroundColor="@color/glass_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"

            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/locationTitle"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/localizacion_overlay_title" />

                <TextView
                    android:id="@+id/locationCoordinates"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/localizacion_placeholder_coordenadas"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- GPS unavailable indicator -->
                <LinearLayout
                    android:id="@+id/gpsStatusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location"
                        android:importantForAccessibility="no"
                        app:tint="?attr/colorError" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/localizacion_gps_no_disponible"
                        android:textSize="11sp"
                        android:textColor="?attr/colorError" />

                    <TextView
                        android:id="@+id/gpsRetryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/localizacion_gps_reintentar"
                        android:textSize="11sp"
                        android:textColor="?attr/colorPrimary"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinnerPueblos"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_edit_text"
                        android:dropDownWidth="match_parent"
                        android:paddingHorizontal="8dp"
                        android:textColor="?attr/colorOnSurface" />

                    <Spinner
                        android:id="@+id/spinnerCalles"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_edit_text"
                        android:dropDownWidth="match_parent"
                        android:paddingHorizontal="8dp"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/overlayBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            app:cardBackgroundColor="@color/glass_light"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp">

         <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:weightSum="7">

            <!-- BOTÓN TEMPLATE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionStreetView"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:gravity="center"
                    app:icon="@drawable/photo_prints_24px"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="@string/localizacion_street_view_action"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Street"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp"
                    android:padding="1dp"/>
            </LinearLayout>

            <!-- CENTRAR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionCenter"
                    style="@style/Widget.Material3.Button.IconButton"
                      android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:gravity="center"

                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/center_focus_weak_24px" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Centrar"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- COPIAR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionCopy"
                    style="@style/Widget.Material3.Button.IconButton"
                      android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:gravity="center"

                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_copy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copiar"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- NAVEGAR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionNavigate"
                    style="@style/Widget.Material3.Button.IconButton"
                   android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:gravity="center"

                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_car" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Navegar"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- COMPARTIR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionShare"
                    style="@style/Widget.Material3.Button.IconButton"
                     android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:gravity="center"

                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_share" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compartir"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />
            </LinearLayout>



            <!-- CAPA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionMapLayer"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:gravity="center"
                    android:contentDescription="@string/localizacion_map_layer_action"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_layers" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capa"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- CALLES -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionToggleStreets"
                    style="@style/Widget.Material3.Button.IconButton"
                      android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:gravity="center"

                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/disabled_visible_24px" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calles"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Map FAB controls: zoom + relocate, right side above the bottom action bar -->
        <LinearLayout
            android:id="@+id/mapFabStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="96dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabRelocate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/localizacion_fab_reubicar"
                android:stateListAnimator="@null"
                app:fabSize="mini"
                app:srcCompat="@drawable/center_focus_weak_24px"
                app:backgroundTint="@color/primary"
                app:tint="@color/white"
                app:elevation="0dp"
                app:pressedTranslationZ="0dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZoomIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/localizacion_fab_zoom_in"
                android:stateListAnimator="@null"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_add"
                app:backgroundTint="@color/primary"
                app:tint="@color/white"
                app:elevation="0dp"
                app:pressedTranslationZ="0dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZoomOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/localizacion_fab_zoom_out"
                android:stateListAnimator="@null"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_remove"
                app:backgroundTint="@color/primary"
                app:tint="@color/white"
                app:elevation="0dp"
                app:pressedTranslationZ="0dp" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/streetViewSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:behavior_fitToContents="false"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/street_view_peek_height"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/on_primary">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Handle pill -->
            <View
                android:id="@+id/streetViewHandle"
                android:layout_width="@dimen/street_view_handle_width"
                android:layout_height="@dimen/street_view_handle_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_bottom_sheet_handle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Header row: icon + title + expand/minimize/close -->
            <LinearLayout
                android:id="@+id/streetViewHeaderRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/streetViewHandle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/photo_prints_24px"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/streetViewTitle"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/localizacion_street_view_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/streetViewActionExpand"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/localizacion_street_view_expand"
                    app:icon="@drawable/ic_expand_less" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/streetViewActionMinimize"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/localizacion_street_view_minimize"
                    app:icon="@drawable/ic_expand_more" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/streetViewActionClose"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/localizacion_street_view_close"
                    app:icon="@drawable/ic_close_sheet" />
            </LinearLayout>

            <!-- Location address + code badge -->
            <LinearLayout
                android:id="@+id/streetViewAddressRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/streetViewHeaderRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/streetViewAddressText"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />

                <TextView
                    android:id="@+id/streetViewCodeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_primary"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:text=""
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Panorama content area -->
            <FrameLayout
                android:id="@+id/streetViewContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/streetViewAddressRow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ViewStub
                    android:id="@+id/streetViewStub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inflatedId="@+id/streetViewPanoramaContainer"
                    android:layout="@layout/include_streetview_panorama" />

                <LinearLayout
                    android:id="@+id/streetViewLoadingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/streetViewLoadingIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/streetViewLoadingText"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/localizacion_street_view_loading"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/streetViewActionSurfaceMode"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="@string/localizacion_street_view_surface_mode"
                    android:text="@string/localizacion_street_view_mode_aerea"
                    app:icon="@drawable/map_24px"
                    app:iconPadding="8dp" />

                <TextView
                    android:id="@+id/streetViewEmptyState"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/localizacion_street_view_empty"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
