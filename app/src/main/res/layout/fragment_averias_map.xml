<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Card informativa al tocar un marcador -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMarkerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:layout_marginBottom="72dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fila título + cerrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMarkerTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="⚡ Avería #2045" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkerCerrar"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_close_sheet"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Fecha y hora del evento -->
            <TextView
                android:id="@+id/tvMarkerFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="🕐 15/06/2025 · 14:32"
                tools:visibility="visible" />

            <!-- Agencia + chip estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMarkerAgencia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="🏢 Agencia Central" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMarkerEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:textSize="11sp"
                    tools:text="Pendiente" />
            </LinearLayout>

            <!-- Técnico asignado -->
            <TextView
                android:id="@+id/tvMarkerTecnico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="👷 Técnico: Juan Pérez"
                tools:visibility="visible" />

            <!-- Atendido por (solo resueltas) -->
            <TextView
                android:id="@+id/tvMarkerAtendidoPor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="✅ Atendido por: Juan Pérez"
                tools:visibility="visible" />

            <!-- Causa -->
            <TextView
                android:id="@+id/tvMarkerCausa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="⚠️ Causa: Transformador quemado"
                tools:visibility="visible" />

            <!-- Dirección -->
            <TextView
                android:id="@+id/tvMarkerDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="📍 San José, Costa Rica"
                tools:visibility="visible" />

            <!-- NISE -->
            <TextView
                android:id="@+id/tvMarkerNise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="🔢 NISE: 123456"
                tools:visibility="visible" />

            <!-- Observación -->
            <TextView
                android:id="@+id/tvMarkerObservacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="📝 Transformador quemado cerca del parque."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkerVerAveria"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/averias_mapa_abrir_averia" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FAB: centrar en mi ubicación — lado izquierdo para no tapar zoom controls -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:contentDescription="@string/averias_mapa_mi_ubicacion"
        android:src="@drawable/ic_my_location"
        android:tint="@color/white"
        app:backgroundTint="@color/ice_blue"
        app:fabSize="normal"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
