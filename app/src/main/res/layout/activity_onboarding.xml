<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.onboarding.OnboardingActivity">

    <!-- ViewPager2 ocupa toda la pantalla con padding inferior
         para que los botones no tapen el contenido de la página -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp"
        android:clipToPadding="false" />

    <!-- Capa inferior fija: indicadores + botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground">

        <!-- Indicadores de punto -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            app:tabGravity="center"
            app:tabIndicatorColor="@color/ice_blue"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorGravity="center"
            app:tabIndicatorHeight="4dp"
            app:tabRippleColor="@color/transparent"
            app:tabSelectedTextColor="@color/transparent"
            app:tabTextColor="@color/transparent"
            tools:ignore="SpeakableTextPresentCheck" />

        <!-- Fila de botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:paddingTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSkip"
                style="@style/Tecni.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/onboarding_action_skip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNext"
                style="@style/Tecni.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:text="@string/onboarding_action_next"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:cornerRadius="24dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
