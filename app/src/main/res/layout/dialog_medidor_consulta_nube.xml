<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="32dp"
    android:paddingBottom="28dp">

    <!-- Ícono de nube -->
    <ImageView
        android:id="@+id/iconConsultaNube"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_icon_wrap_blue"
        android:padding="12dp"
        android:contentDescription="@string/medidor_dialog_consulta_icon"
        android:src="@drawable/ic_cloud_download"
        app:tint="@color/status_in_progress" />

    <!-- Indicador de progreso -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressConsultaNube"
        style="@style/Widget.Material3.CircularProgressIndicator.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant" />

    <TextView
        android:id="@+id/textConsultaTitulo"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/medidor_dialog_consulta_nube_title"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textConsultaMensaje"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/medidor_dialog_consulta_nube_message"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
