<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@color/surface"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/outline_variant" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_icon_wrap_blue"
                android:contentDescription="@string/registro_pendiente_title"
                android:padding="12dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/status_in_progress" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registro_pendiente_title"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRegistroFechaHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    tools:text="Hoy · lunes" />
            </LinearLayout>
        </LinearLayout>

        <!-- Warning info box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_box_yellow"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                app:tint="@color/status_assigned" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/registro_pendiente_message"
                android:textColor="#F5C963"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- Fecha (read-only, pre-filled) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegistroFecha"
            style="@style/Tecni.TextInput.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:enabled="false"
            android:hint="@string/vehiculo_registro_fecha"
            app:boxStrokeColor="@color/outline_variant"
            app:hintTextColor="@color/on_surface_variant"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegistroFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Lectura inicial -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegistroValor"
            style="@style/Tecni.TextInput.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/vehiculo_registro_km_orimetro"
            app:boxStrokeColor="@color/outline_variant"
            app:hintTextColor="@color/on_surface_variant"
            app:startIconDrawable="@drawable/ic_speedometer"
            app:startIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegistroValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Switch: cerrar registro -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRegistroCerrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/registro_pendiente_cerrar_label"
            android:text="@string/registro_pendiente_cerrar_label"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/tvRegistroModoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/registro_pendiente_modo_inicial_info"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <!-- Sección de cierre (expandible) -->
        <LinearLayout
            android:id="@+id/layoutRegistroCierre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Divider label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="@string/registro_pendiente_cierre_label"
                android:textAllCaps="true"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <!-- Km Final -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegistroKmFinal"
                style="@style/Tecni.TextInput.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/mi_vehiculo_registro_km_final_hint"
                app:boxStrokeColor="@color/outline_variant"
                app:hintTextColor="@color/on_surface_variant"
                app:startIconDrawable="@drawable/ic_speedometer"
                app:startIconTint="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroKmFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Combustible + Horas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegistroCombustible"
                    style="@style/Tecni.TextInput.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:hint="@string/vehiculo_registro_combustible"
                    app:boxStrokeColor="@color/outline_variant"
                    app:hintTextColor="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegistroCombustible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegistroHoras"
                    style="@style/Tecni.TextInput.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/mi_vehiculo_registro_horas_hint"
                    app:boxStrokeColor="@color/outline_variant"
                    app:hintTextColor="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegistroHoras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Actividad -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegistroActividad"
                style="@style/Tecni.TextInput.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/mi_vehiculo_registro_actividad_hint"
                app:boxStrokeColor="@color/outline_variant"
                app:hintTextColor="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Cuenta + N° Caso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegistroCuenta"
                    style="@style/Tecni.TextInput.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:hint="@string/mi_vehiculo_registro_cuenta_hint"
                    app:boxStrokeColor="@color/outline_variant"
                    app:hintTextColor="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegistroCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegistroCaso"
                    style="@style/Tecni.TextInput.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/mi_vehiculo_registro_caso_hint"
                    app:boxStrokeColor="@color/outline_variant"
                    app:hintTextColor="@color/on_surface_variant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegistroCaso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Lugar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegistroLugar"
                style="@style/Tecni.TextInput.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/mi_vehiculo_registro_lugar_hint"
                app:boxStrokeColor="@color/outline_variant"
                app:hintTextColor="@color/on_surface_variant"
                app:startIconDrawable="@drawable/ic_location"
                app:startIconTint="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroLugar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Observaciones -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegistroObservaciones"
                style="@style/Tecni.TextInput.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/vehiculo_registro_observaciones"
                app:boxStrokeColor="@color/outline_variant"
                app:hintTextColor="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegistroObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Registrar button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistroDialogRegistrar"
            style="@style/Tecni.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/registro_pendiente_registrar" />

        <!-- Sin vehículo button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistroDialogSinVehiculo"
            style="@style/Tecni.Button.Outlined.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/registro_pendiente_sin_vehiculo" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
