<?xml version="1.0" encoding="utf-8"?>
<!--
    notification_averia_expanded.xml
    Vista expandida de la notificación de avería.

    CAMBIOS vs versión anterior:
    - LinearLayout anidados → ConstraintLayout flat (sin profundidad de jerarquía innecesaria)
    - ELIMINADOS: @+id/impact, @+id/technician, @+id/time — el Dispatcher nunca los
      seteaba, dejando TextViews vacíos que ocupaban espacio y podían lanzar un
      RemoteViews crash silencioso si el dimen de map_preview fallaba.
    - ELIMINADO: @+id/map_preview (ImageView estático sin imagen real seteada —
      mostraba solo el background drawable vacío, desperdiciando la altura del mapa).
      Si en el futuro se agrega Static Maps API, re-agregar aquí.
    - ELIMINADOS: @+id/action_detail, @+id/action_map, @+id/action_attend dentro
      del layout — las acciones ya se manejan correctamente vía NotificationCompat
      .addAction() en el Dispatcher, que es la forma correcta en Android 12+.
    - Colores via @color (night mode ready)
    - Se usa @color/averia_notification_on_surface_variant para campos secundarios
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- ── Fila superior: ícono + título + caso + estado ─────────────── -->

    <ImageView
        android:id="@+id/icon_large"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_notification_bolt"
        android:contentDescription="@string/averia_notificacion_map_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/averia_notification_on_surface"
        android:textStyle="bold"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/icon_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/icon_large" />

    <TextView
        android:id="@+id/case_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/averia_notification_on_surface"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/icon_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/state_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/averia_notification_pending"
        android:textStyle="bold"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/icon_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/case_line" />

    <!-- ── Separador visual ──────────────────────────────────────────── -->

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/averia_notification_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icon_large" />

    <!-- ── Detalle ────────────────────────────────────────────────────── -->

    <!-- Localización / dirección -->
    <TextView
        android:id="@+id/address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/averia_notification_on_surface_variant"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <!-- Agencia -->
    <TextView
        android:id="@+id/agency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/averia_notification_on_surface"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address" />

    <!-- Cliente -->
    <TextView
        android:id="@+id/customer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/averia_notification_on_surface"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/agency" />

    <!-- Causa -->
    <TextView
        android:id="@+id/cause"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/averia_notification_on_surface_variant"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/customer" />

    <!-- Clientes afectados -->
    <TextView
        android:id="@+id/affected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/averia_notification_on_surface_variant"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cause"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>