<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.programacion.ProgramacionFragment">

    <!-- Imagen destacada -->
    <ImageView
        android:id="@+id/image_header"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:src="@drawable/logo"
        app:layout_constraintBottom_toTopOf="@+id/text_under_construction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Texto indicando que la página está en construcción -->
    <TextView
        android:id="@+id/text_under_construction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Esta página está en construcción."
        android:textSize="20sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_header" />


</androidx.constraintlayout.widget.ConstraintLayout>
