<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/averia_notification_icon_size"
        android:layout_height="@dimen/averia_notification_icon_size"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_averia_notification"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/averia_notificacion_map_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/averia_notification_on_surface"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_gray"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/averia_notification_line_spacing" />

        <TextView
            android:id="@+id/case_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/averia_notification_on_surface"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/averia_notification_line_spacing" />

        <TextView
            android:id="@+id/state_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/averia_notification_pending"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/averia_notification_line_spacing" />
    </LinearLayout>
</LinearLayout>
